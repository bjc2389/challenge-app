{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types", "node"],
    // Type-checks scripts/lib/catalog.mjs through its JSDoc, and lets tests import
    // catalog.json. The client tsconfig has neither, so a client import fails too.
    "allowJs": true,
    "checkJs": true,
    "resolveJsonModule": true
  },
  "include": ["src/worker", "test", "scripts/lib", "*.config.ts"]
}
