{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npm exec wrangler deploy:*)",
      "Bash(wrangler secret:*)",
      "Bash(npx wrangler secret:*)",
      "Bash(npm exec wrangler secret:*)",
      "Bash(wrangler * --remote*)",
      "Bash(npx wrangler * --remote*)",
      "Bash(npm exec wrangler * --remote*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin staging:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push -u origin staging:*)",
      "Bash(git push * HEAD:main*)",
      "Bash(git push * HEAD:staging*)",
      "Edit(.dev.vars)",
      "Edit(**/.dev.vars)",
      "Edit(.env)",
      "Edit(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.mjs\"",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-files.mjs\""
          }
        ]
      }
    ]
  }
}
